# GetXAPI key — get from getxapi.com dashboard
GETXAPI_KEY=

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=

# Resend API key — get from resend.com dashboard
RESEND_API_KEY=

# Email address to send the weekly report to
EMAIL_TO=

# X List ID to pull accounts from (numeric ID from the list URL)
X_LIST_ID=

# Your X username (without @)
X_USERNAME=

# Supabase Postgres connection string — Project Settings → Database →
# Connection string → URI (use the pooler / port 6543 for the weekly job)
DATABASE_URL=

# GitHub token + user for publishing the dashboard as a secret gist
GITHUB_TOKEN=
GITHUB_USER=
